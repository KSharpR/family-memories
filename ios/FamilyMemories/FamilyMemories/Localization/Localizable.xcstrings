    "settings.import.invalid.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup file is invalid, incomplete, or from an unsupported version. Your existing memories were not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个备份文件无效、不完整，或来自不支持的版本。你现有的回忆没有被修改。"
          }
        }
      }
    }
