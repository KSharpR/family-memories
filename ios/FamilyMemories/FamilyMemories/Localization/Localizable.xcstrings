    "settings.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected photos are copied into this app on this device. No account, server, or automatic upload is used. Backups are created only when you export them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择的照片会复制到本机 App 内。这里不需要账号，不使用服务器，也不会自动上传。只有你主动导出时才会创建备份。"
          }
        }
      }
    },
