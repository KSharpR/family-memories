      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份"
          }
        }
      }
    },
    "settings.backup.reminder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are local files you create manually. Keep a copy somewhere you control."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份是你手动创建的本地文件，请保存到你自己掌控的位置。"
          }
        }
      }
    },
    "settings.export.ready.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination to save or share this backup file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个位置来保存或分享这个备份文件。"
          }
        }
      }
    },
